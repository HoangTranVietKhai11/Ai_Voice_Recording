# Cấu hình môi trường VoiceNote AI
# Sao chép thành .env và điều chỉnh cho phù hợp

# ── Ứng dụng ─────────────────────────────────────────────────────────
APP_NAME=VoiceNote AI

# ── Đường dẫn dữ liệu ────────────────────────────────────────────────
UPLOAD_DIR=./data/audio
DB_PATH=./data/db/voicenote.db

# ── Giới hạn tải file ─────────────────────────────────────────────────
MAX_UPLOAD_MB=100

# ── Mô hình Whisper ───────────────────────────────────────────────────
# Lựa chọn: tiny | base | small | medium | large-v3
# tiny: ~39MB RAM, nhanh nhất; base: ~74MB, cân bằng tốt
WHISPER_MODEL=base
WHISPER_DEVICE=cpu          # cpu | cuda
WHISPER_COMPUTE=int8        # int8 (CPU nhanh nhất) | float16 (GPU)

# ── Dịch thuật ────────────────────────────────────────────────────────
# Lựa chọn: google | ollama | mock
TRANSLATION_PROVIDER=google
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# ── Bảo mật (BẮT BUỘC khi mở ra ngoài LAN) ─────────────────────────
# Tạo token: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# API_TOKEN=THAY_BANG_MAT_KHAU_NGAU_NHIEN_DAI_IT_NHAT_32_KY_TU

# ── CORS (dev local – không cần trong Docker) ─────────────────────────
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
