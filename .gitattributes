# Mặc định: auto-detect, normalize về LF trong repo
* text=auto eol=lf

# Shell scripts PHẢI là LF (chạy trên Linux/Docker)
*.sh text eol=lf

# Config files chạy trong container
Dockerfile text eol=lf
Caddyfile  text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.env*     text eol=lf

# Source code
*.py       text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.js       text eol=lf
*.jsx      text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.toml     text eol=lf

# Binary – không touch
*.png      binary
*.jpg      binary
*.webp     binary
*.webm     binary
*.mp3      binary
*.wav      binary
*.m4a      binary
*.ogg      binary
*.whl      binary
