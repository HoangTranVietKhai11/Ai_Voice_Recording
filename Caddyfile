# Caddyfile cho VoiceNote AI
#
# Trường hợp 1: LAN nội bộ với TLS tự ký (Tailscale / IP nội bộ)
#   → Thay "voicenote.local" bằng tên máy Proxmox hoặc IP LAN
#   → Trình duyệt cần tin cậy CA của Caddy (chạy: caddy trust)
#
# Trường hợp 2: Domain công khai với TLS từ Let's Encrypt
#   → Thay bằng domain thật, Caddy tự lấy cert
#
# Trường hợp 3: Tailscale HTTPS
#   → Dùng "tailscale" tls_ca và tên máy Tailscale
#   → Xem: https://caddyserver.com/docs/automatic-https#tailscale

{
    # Email cho Let's Encrypt (chỉ dùng khi có domain công khai)
    # email admin@example.com
    
    # Log level
    log {
        level INFO
    }
}

# ── Cấu hình chính ─────────────────────────────────────────────────────
# LAN nội bộ: dùng IP hoặc tên máy (Caddy tự tạo self-signed cert)
:443 {
    tls internal   # TLS tự ký – trình duyệt sẽ cảnh báo, chấp nhận 1 lần

    # Giới hạn tốc độ tải file (bảo vệ tài nguyên)
    @upload {
        method POST
        path /api/audio
    }

    # Header bảo mật cơ bản
    header {
        X-Frame-Options DENY
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        # Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline';"
        -Server
    }

    # Proxy ngược tới ứng dụng FastAPI
    reverse_proxy app:8000 {
        # Health check cho Caddy
        health_uri /health
        health_interval 30s
        health_timeout 5s
        
        # Header gốc
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# Chuyển hướng HTTP → HTTPS
:80 {
    redir https://{host}{uri} permanent
}
