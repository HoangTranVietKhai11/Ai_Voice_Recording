# Caddyfile cho VoiceNote AI

{
    log {
        level INFO
    }
}

# ── HTTP truy cập trực tiếp không cần chứng chỉ (Port 80) ─────────────
:80 {
    reverse_proxy app:8000
}

# ── HTTPS cho quyền truy cập Micro (Port 443) ────────────────────────
https://100.103.205.56, https://didongviet.tailcf4175.ts.net, https://10.0.10.50, https://10.0.11.93, https://localhost, https://127.0.0.1 {
    tls internal

    # Header bảo mật cơ bản
    header {
        X-Frame-Options DENY
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # Proxy ngược tới ứng dụng FastAPI
    reverse_proxy app:8000
}
